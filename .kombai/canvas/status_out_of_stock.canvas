      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n.fh{font-family:'Cinzel',serif}\n.fb{font-family:'Inter',sans-serif}\n</style>\n<div class=\"fb bg-[#080808] text-white antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n<header class=\"sticky top-0 z-40 bg-[#080808]/95 backdrop-blur-md border-b border-[#222222]\" data-kid=\"1-1\" data-name=\"sticky header bar\">\n<div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header inner row with logo nav and icons\">\n<div class=\"flex items-center gap-6\" data-kid=\"1-1-1-1\" data-name=\"header left group with logo and profile link\">\n<a class=\"flex flex-col\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<span class=\"fh text-2xl font-black tracking-[0.4em] uppercase leading-none\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand name text\">STATUS</span>\n<span class=\"text-[8px] tracking-[0.6em] text-[#999999] font-semibold uppercase mt-1\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand tagline text\">HAUTE COUTURE</span>\n</a>\n<a class=\"border border-[#222222] px-4 py-2 text-[10px] font-bold uppercase tracking-wider text-[#b83b4b] hover:text-white hover:border-[#b83b4b] transition-colors\" data-kid=\"1-1-1-1-2\" data-name=\"profile navigation link\" href=\"#\">Мой профиль</a>\n</div>\n<nav class=\"hidden md:flex items-center gap-8 text-[11px] tracking-[0.25em] font-semibold uppercase text-[#999999]\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a class=\"hover:text-white transition-colors\" data-kid=\"1-1-1-2-1\" data-name=\"nav link home\" href=\"#\">ГЛАВНАЯ</a>\n<a class=\"hover:text-white transition-colors\" data-kid=\"1-1-1-2-2\" data-name=\"nav link collection section\" href=\"#\">КОЛЛЕКЦИЯ</a>\n<a class=\"text-[#b8